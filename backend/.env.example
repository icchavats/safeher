PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or local)
# Example Local: mongodb://127.0.0.1:27017/safevoice
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/safevoice?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/safevoice

# JWT Secret Key
JWT_SECRET=safevoice_super_secret_jwt_key_2026_safeher_secure

# Telegram Bot Integration for Emergency SOS Dispatches
# Create bot via @BotFather on Telegram to get token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional Default Telegram Chat ID or Channel ID for central dispatch
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here
